{
	"name": "frankstack",
	"private": true,
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"build": "bun run --filter '*' build",
		"typecheck": "bun run --filter '*' check",
		"test": "bun run --filter '*' test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12"
	}
}
